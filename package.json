{
  "name": "basic-language-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "web-vitals": "^6.2.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "minimatch": "^11.0.4",
    "glob": "^14.0.3",
    "deepmerge": "$deepmerge"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build && node scripts/build-offline-packs.mjs && node scripts/generate-seo-routes.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "dev": "vite",
    "generate-audio": "python3 scripts/generate-all-audio.py",
    "generate-audio:force": "python3 scripts/generate-all-audio.py --force",
    "generate-audio:time": "python3 scripts/generate-time-audio.py",
    "generate-offline-manifests": "node scripts/generate-offline-manifests.mjs",
    "build-offline-packs": "node scripts/build-offline-packs.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "deepmerge": "file:vendor/deepmerge",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
